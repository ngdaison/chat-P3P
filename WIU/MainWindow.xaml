<Window x:Class="P2PChatApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:P2PChatApp"
        mc:Ignorable="d"
        Title="P2P Chat — Ứng Dụng Trò Chuyện Phi Tập Trung"
        Height="740" Width="1080"
        MinHeight="620" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}">

    <!-- Modern Windows 11 Seamless Chrome -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:InitialsConverter x:Key="Initials" />
        <local:AvatarBrushConverter x:Key="AvatarBrush" />
        <local:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom Integrated Title Bar -->
            <RowDefinition Height="42" />
            <!-- Main Content Canvas -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 1. CUSTOM INTEGRATED TITLE BAR (WindowChrome) -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Left: App Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" HorizontalAlignment="Left">
                    <!-- Icon Box -->
                    <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0078D4" Offset="0" />
                                <GradientStop Color="#00BCF9" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🛡" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="P2P Chat" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Background="#1A00BCF9" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitleTag" Text="PHI TẬP TRUNG · 100% RUST" FontSize="10" FontWeight="SemiBold" Foreground="#00BCF9" />
                    </Border>
                </StackPanel>

                <!-- Center: Live Status Pill -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#1AFFFFFF" CornerRadius="12" Padding="12,4"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="NodeStatusDot" Width="7" Height="7" Fill="{StaticResource OnlineGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="NodeStatusText" Text="Đang hoạt động (Cổng 7001)" FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button x:Name="BtnQuickCopyId" Content="📋 Sao chép ID"
                                Style="{StaticResource CaptionButton}" Width="Auto" Height="Auto" Padding="6,2" FontSize="10"
                                Click="BtnCopyMyId_Click" />
                    </StackPanel>
                </Border>

                <!-- Right: 100% Windows 11 Native Pixel-Perfect Caption Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Minimize Button: Exact 10x1 line -->
                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" Click="BtnMinimize_Click" ToolTip="Thu nhỏ">
                        <Path Data="M 0,0 L 10,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              SnapsToDevicePixels="True"
                              RenderOptions.EdgeMode="Aliased"
                              Width="10" Height="1" />
                    </Button>

                    <!-- Maximize / Restore Button: Exact 10x10 square or Restore dual squares -->
                    <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButton}" Click="BtnMaximize_Click" ToolTip="Phóng to">
                        <Grid Width="10" Height="10">
                            <!-- Normal state: 10x10 square box -->
                            <Rectangle x:Name="IconMaximize" Width="10" Height="10"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1"
                                       SnapsToDevicePixels="True"
                                       RenderOptions.EdgeMode="Aliased"
                                       Fill="Transparent" />
                            <!-- Maximized state: Dual overlapping squares (Windows 11 Restore) -->
                            <Path x:Name="IconRestore"
                                  Data="M 2,0 L 10,0 L 10,8 L 8,8 M 8,2 L 8,10 L 0,10 L 0,2 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"
                                  SnapsToDevicePixels="True"
                                  RenderOptions.EdgeMode="Aliased"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <!-- Close Button: Exact 10x10 45-degree cross, turns Windows 11 Red #C42B1C on hover -->
                    <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButton}" Click="BtnClose_Click" ToolTip="Đóng">
                        <Path Data="M 0,0 L 10,10 M 0,10 L 10,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              SnapsToDevicePixels="True"
                              RenderOptions.EdgeMode="Aliased"
                              Width="10" Height="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN WORKSPACE (SIDEBAR + CONTENT PANELS) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Navigation Sidebar -->
                <ColumnDefinition Width="220" />
                <!-- Content View -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- User Profile Footer -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBgBrush}" Margin="10" Padding="10" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Avatar -->
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                    Background="{StaticResource AccentBrush}" Margin="0,0,8,0">
                                <TextBlock Text="TÔI" FontSize="10" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtShortPeerId" Text="Đang tải..." FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TxtPeerCount" Text="0 node đang kết nối" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Nav Items -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock x:Name="LblNavChannels" Text="KÊNH TRÒ CHUYỆN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="16,4,0,8" />
                        <RadioButton x:Name="NavDirectChat" Content="💬  Tin nhắn trực tiếp"
                                     Style="{StaticResource FluentNavButton}" IsChecked="True"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavGroupChat" Content="👥  Nhóm bảo mật"
                                     Style="{StaticResource FluentNavButton}"
                                     Checked="Nav_Checked" />

                        <TextBlock x:Name="LblNavNetworking" Text="MẠNG &amp; BẢO MẬT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="16,14,0,8" />
                        <RadioButton x:Name="NavContacts" Content="📖  Danh bạ liên hệ"
                                     Style="{StaticResource FluentNavButton}"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavFiles" Content="📁  Truyền tệp tin"
                                     Style="{StaticResource FluentNavButton}"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavNetwork" Content="🌐  Mạng P2P &amp; Relay"
                                     Style="{StaticResource FluentNavButton}"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSettings" Content="⚙️  Cài đặt"
                                     Style="{StaticResource FluentNavButton}"
                                     Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- VIEW 1: DIRECT MESSAGES -->
            <Grid x:Name="ViewDirectChat" Grid.Column="1" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <!-- Conversations List Column -->
                    <ColumnDefinition Width="260" />
                    <!-- Chat Canvas Column -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Conversations List -->
                <Border Grid.Column="0" Background="#161616" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!-- Top search bar & add button -->
                        <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearchContact" Grid.Column="0" Style="{StaticResource FluentTextBox}"
                                         Padding="8,6" FontSize="12"
                                         TextChanged="TxtSearchContact_TextChanged" />
                                <Button x:Name="BtnAddContactQuick" Grid.Column="1" Content="+ Thêm" Style="{StaticResource FluentSecondaryButton}"
                                        Padding="8,5" FontSize="11" Margin="6,0,0,0" Click="BtnNavToAddContact_Click" />
                            </Grid>
                        </Border>

                        <!-- Contact List Items -->
                        <ListBox x:Name="LstChatContacts" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="LstChatContacts_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Initials Avatar -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                    Background="{Binding Name, Converter={StaticResource AvatarBrush}}">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource Initials}}"
                                                           FontSize="12" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="13" />
                                                <TextBlock Text="{Binding Fingerprint}" Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Chat Canvas -->
                <Grid Grid.Column="1">
                    <!-- EMPTY STATE (When no contact is selected) -->
                    <Border x:Name="ChatEmptyState" Background="{StaticResource WindowBgBrush}" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#150078D4" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="🛡" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#00BCF9" />
                            </Border>
                            <TextBlock x:Name="LblEmptyHeroTitle" Text="Trò Chuyện Mã Hóa Đầu Cuối P2P" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="LblEmptyHeroSub" Text="Không qua máy chủ · Tuyệt đối bảo mật · 100% Rust Core" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,16" />
                            <TextBlock x:Name="LblEmptyHeroDesc" Text="Chọn một người liên hệ từ danh sách bên trái hoặc nhấn '+ Thêm' để bắt đầu trò chuyện an toàn."
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- ACTIVE CHAT VIEW -->
                    <Grid x:Name="ChatActivePane" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <!-- Chat Header -->
                            <RowDefinition Height="56" />
                            <!-- Messages Area -->
                            <RowDefinition Height="*" />
                            <!-- Input Bar -->
                            <RowDefinition Height="68" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                            <Grid VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="ChatHeaderAvatar" Width="36" Height="36" CornerRadius="18"
                                            Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                                        <TextBlock x:Name="TxtChatHeaderInitials" Text="?" FontSize="13" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtChatContactName" Text="Tên liên hệ"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Background="#15107C41" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock x:Name="LblVerifiedBadge" Text="✓ ĐÃ XÁC THỰC E2EE" FontSize="9" FontWeight="Bold" Foreground="#107C41" />
                                            </Border>
                                            <TextBlock x:Name="TxtChatContactFingerprint" Text="Mã xác thực: ..." FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnSendFileQuick" Content="📎 Gửi tệp"
                                            Style="{StaticResource FluentSecondaryButton}" Click="BtnSendFileQuick_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Messages Scroll Area -->
                        <ScrollViewer x:Name="ScrollMessages" Grid.Row="1" Padding="20,12">
                            <ItemsControl x:Name="ItemsMessages">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <!-- Outgoing Message Bubble (Right) -->
                                            <Border HorizontalAlignment="Right" MaxWidth="520"
                                                    Background="{StaticResource OutgoingBubbleBrush}"
                                                    CornerRadius="14,14,2,14" Padding="14,9" Margin="60,0,0,0"
                                                    Visibility="{Binding IsOutgoing, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="White" FontSize="13" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#D5E8FF" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#D5E8FF" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Incoming Message Bubble (Left) -->
                                            <Border HorizontalAlignment="Left" MaxWidth="520"
                                                    Background="{StaticResource CardBgBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="14,14,14,2" Padding="14,9" Margin="0,0,60,0"
                                                    Visibility="{Binding IsOutgoing, Converter={StaticResource InverseBoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold" Foreground="#00BCF9" Margin="0,0,0,3" />
                                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                                    <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Right" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Modern Rounded Input Bar -->
                        <Border Grid.Row="2" Background="{StaticResource HeaderBgBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                            <Border Background="{StaticResource InputBgBrush}" CornerRadius="22"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Paperclip attach button -->
                                    <Button x:Name="BtnAttachClip" Grid.Column="0" Content="📎" Style="{StaticResource CaptionButton}"
                                            Width="34" Height="34" FontSize="14" Click="BtnSendFileQuick_Click" ToolTip="Đính kèm tệp gửi đi" />

                                    <!-- Text Input -->
                                    <TextBox x:Name="TxtMessageInput" Grid.Column="1"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="White" FontSize="13" CaretBrush="White"
                                             VerticalAlignment="Center" Padding="8,6"
                                             KeyDown="TxtMessageInput_KeyDown" />

                                    <!-- Send Circular Button -->
                                    <Button x:Name="BtnSendMessage" Grid.Column="2" Content="➤"
                                            Style="{StaticResource FluentPrimaryButton}"
                                            Width="34" Height="34" Padding="0" Margin="0,0,2,0"
                                            FontSize="12" Click="BtnSendMessage_Click" ToolTip="Gửi tin nhắn (Enter)" />
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- VIEW 2: GROUP CHAT -->
            <Grid x:Name="ViewGroupChat" Grid.Column="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#161616" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock x:Name="LblGroupHeader" Text="NHÓM TRÒ CHUYỆN MÃ HÓA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <Button x:Name="BtnCreateGroup" Content="+ Tạo nhóm" Style="{StaticResource FluentSecondaryButton}"
                                        Padding="8,4" FontSize="11" HorizontalAlignment="Right" Click="BtnCreateGroup_Click" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="LstGroups" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="LstGroups_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="13" />
                                            <TextBlock Text="{Binding Epoch, StringFormat='Kỷ nguyên Epoch {0}'}" Foreground="#00BCF9" FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="68" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                        <Grid VerticalAlignment="Center">
                            <TextBlock x:Name="TxtActiveGroupName" Text="Chọn hoặc tạo nhóm mới"
                                       FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button x:Name="BtnAddGroupMember" Content="+ Thêm thành viên"
                                    Style="{StaticResource FluentSecondaryButton}" HorizontalAlignment="Right"
                                    Click="BtnAddGroupMember_Click" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="ScrollGroupMessages" Grid.Row="1" Padding="20,12">
                        <StackPanel x:Name="PanelGroupMessages" />
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{StaticResource HeaderBgBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                        <Border Background="{StaticResource InputBgBrush}" CornerRadius="22"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtGroupMessageInput" Grid.Column="0"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="13" CaretBrush="White"
                                         VerticalAlignment="Center" Padding="12,6"
                                         KeyDown="TxtGroupMessageInput_KeyDown" />
                                <Button x:Name="BtnSendGroupMessage" Grid.Column="1" Content="➤"
                                        Style="{StaticResource FluentPrimaryButton}"
                                        Width="34" Height="34" Padding="0" Margin="0,0,2,0"
                                        FontSize="12" Click="BtnSendGroupMessage_Click" />
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Grid>

            <!-- VIEW 3: CONTACTS BOOK -->
            <ScrollViewer x:Name="ViewContacts" Grid.Column="1" Visibility="Collapsed" Padding="24">
                <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                    <!-- My Identity Hero Card -->
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="18"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="LblMyIdentityTitle" Text="DANH TÍNH MÃ HÓA CỦA BẠN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" />
                            <TextBlock x:Name="LblMyIdentityDesc" Text="Chia sẻ Khóa công khai của bạn để bạn bè có thể thêm bạn trực tiếp vào danh bạ P2P an toàn."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" />

                            <TextBlock x:Name="LblPubKeyTitle" Text="Khóa công khai X25519 (64 ký tự hex):" FontSize="11" FontWeight="Medium" Foreground="#CCCCCC" />
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFullPubKey" Grid.Column="0" Style="{StaticResource FluentTextBox}" IsReadOnly="True" />
                                <Button x:Name="BtnCopyPubKey" Grid.Column="1" Content="Sao chép Khóa" Style="{StaticResource FluentSecondaryButton}"
                                        Margin="8,0,0,0" Click="BtnCopyPubKey_Click" />
                            </Grid>

                            <TextBlock x:Name="LblPeerIdTitle" Text="Mã định danh Peer ID (SHA-256):" FontSize="11" FontWeight="Medium" Foreground="#CCCCCC" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFullPeerId" Grid.Column="0" Style="{StaticResource FluentTextBox}" IsReadOnly="True" />
                                <Button x:Name="BtnCopyPeerId" Grid.Column="1" Content="Sao chép ID" Style="{StaticResource FluentSecondaryButton}"
                                        Margin="8,0,0,0" Click="BtnCopyMyId_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Add New Contact Card -->
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="18"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="LblAddContactTitle" Text="Thêm Bạn Mới Vào Danh Bạ" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock x:Name="LblAddContactDesc" Text="Nhập tên gợi nhớ và dán khóa công khai hex 64 ký tự của bạn bè."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewContactName" Grid.Column="0" Style="{StaticResource FluentTextBox}"
                                         Margin="0,0,10,0" />
                                <TextBox x:Name="TxtNewContactPubKey" Grid.Column="1" Style="{StaticResource FluentTextBox}"
                                         Margin="0,0,10,0" />
                                <Button x:Name="BtnAddContact" Grid.Column="2" Content="+ Thêm Liên Hệ"
                                        Style="{StaticResource FluentPrimaryButton}" Click="BtnAddContact_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Contacts List -->
                    <TextBlock x:Name="LblSavedContacts" Text="DANH SÁCH LIÊN HỆ ĐÃ LƯU" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,8" />
                    <ListBox x:Name="LstAllContacts" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="8"
                                        Padding="16,12" Margin="0,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                                Background="{Binding Name, Converter={StaticResource AvatarBrush}}">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource Initials}}"
                                                       FontSize="13" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="{Binding Fingerprint, StringFormat='Mã xác thực bảo mật: {0}'}" FontSize="11"
                                                       Foreground="#00BCF9" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding PublicKey, StringFormat='Khóa công khai: {0}'}" FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="💬 Nhắn tin"
                                                Style="{StaticResource FluentSecondaryButton}"
                                                Tag="{Binding}" Click="BtnChatWithContact_Click" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

            <!-- VIEW 4: FILE TRANSFERS -->
            <ScrollViewer x:Name="ViewFiles" Grid.Column="1" Visibility="Collapsed" Padding="24">
                <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                    <!-- Send File Card -->
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="18"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="LblSendFileTitle" Text="Gửi Tệp Tin Mã Hóa Phân Đoạn (256 KiB)" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock x:Name="LblSendFileDesc" Text="Tệp được chia thành các khối 256 KiB, mã hóa ChaCha20-Poly1305 với chữ ký số Ed25519."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbFileContact" Grid.Column="0" Height="36" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtFilePath" Grid.Column="1" Style="{StaticResource FluentTextBox}" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="BtnBrowseFile" Content="Chọn tệp..." Style="{StaticResource FluentSecondaryButton}"
                                            Click="BtnBrowseFile_Click" Margin="0,0,8,0" />
                                    <Button x:Name="BtnSendFileAction" Content="Gửi Tệp" Style="{StaticResource FluentPrimaryButton}"
                                            Click="BtnSendFileAction_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Active Transfers -->
                    <Grid Margin="0,8,0,8">
                        <TextBlock x:Name="LblActiveTransfers" Text="DANH SÁCH TRUYỀN TỆP &amp; TẢI VỀ" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <Button x:Name="BtnOpenDownloads" Content="Mở thư mục Tải về" Style="{StaticResource FluentSecondaryButton}"
                                HorizontalAlignment="Right" Click="BtnOpenDownloads_Click" />
                    </Grid>

                    <ListBox x:Name="LstFileTransfers" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="8"
                                        Padding="14" Margin="0,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding}" FontSize="13" Foreground="White" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

            <!-- VIEW 5: NETWORK & RELAY DASHBOARD -->
            <ScrollViewer x:Name="ViewNetwork" Grid.Column="1" Visibility="Collapsed" Padding="24">
                <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                    <!-- Metrics Row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Metric 1 -->
                        <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" CornerRadius="10"
                                Padding="18" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="LblMetricConnected" Text="NODE KẾT NỐI TRỰC TIẾP" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtMetricConnected" Text="0" FontSize="28" FontWeight="Bold" Foreground="#00BCF9" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Metric 2 -->
                        <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" CornerRadius="10"
                                Padding="18" Margin="4,0,4,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="LblMetricKnown" Text="ĐỊA CHỈ TRONG MẠNG" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtMetricKnown" Text="0" FontSize="28" FontWeight="Bold" Foreground="#107C41" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Metric 3 -->
                        <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" CornerRadius="10"
                                Padding="18" Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="LblMetricRelay" Text="DUNG LƯỢNG LƯU HỘ RELAY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtMetricRelay" Text="0 tin (0 KB)" FontSize="18" FontWeight="Bold" Foreground="#FFB900" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Connect to Peer Card -->
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="10"
                            Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="LblConnectTitle" Text="Kết Nối Tới Node P2P Khác" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock x:Name="LblConnectDesc" Text="Khởi tạo bắt tay TCP trực tiếp với một node P2P khác trong mạng."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtConnectPeerAddr" Grid.Column="0" Style="{StaticResource FluentTextBox}"
                                         Text="127.0.0.1:7002" Margin="0,0,10,0" />
                                <Button x:Name="BtnConnectPeer" Grid.Column="1" Content="Kết Nối Node" Style="{StaticResource FluentPrimaryButton}"
                                        Click="BtnConnectPeer_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- VIEW 6: SETTINGS (Includes Language Settings) -->
            <ScrollViewer x:Name="ViewSettings" Grid.Column="1" Visibility="Collapsed" Padding="24">
                <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                    <TextBlock x:Name="LblSettingsHeader" Text="Cài Đặt &amp; Ngôn Ngữ Hệ Thống" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16" />

                    <!-- LANGUAGE SETTINGS CARD -->
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="18"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="LblLangTitle" Text="Ngôn ngữ giao diện (Interface Language)" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock x:Name="LblLangDesc" Text="Tùy chọn ngôn ngữ hiển thị cho toàn bộ ứng dụng."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbLanguage" Grid.Column="0" Height="36"
                                          SelectionChanged="CmbLanguage_SelectionChanged">
                                    <ComboBoxItem Content="Tiếng Việt (Mặc định)" IsSelected="True" />
                                    <ComboBoxItem Content="English (Tiếng Anh)" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ARCHITECTURE INFO CARD -->
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="18"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="LblTechTitle" Text="Kiến trúc &amp; Công nghệ Lõi" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock x:Name="LblTech1" Text="• Nhân Rust Core thuần: 100% Rust Standard Library (0 thư viện bên ngoài)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                            <TextBlock x:Name="LblTech2" Text="• Giao diện Windows 11 Native: DWM Mica, chuẩn Caption Button Windows, Core Audio" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            <TextBlock x:Name="LblTech3" Text="• Mật mã học: X25519 DH, chữ ký số Ed25519, mã hóa ChaCha20-Poly1305 AEAD" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            <TextBlock x:Name="LblTech4" Text="• Mạng phân tán: Bitcoin-like Gossip Discovery, Store-and-Forward Relay" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 3. BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource HeaderBgBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatusBar" Text="Sẵn sàng. Node P2P phân tán đang hoạt động." FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtAppVersion" Text="WIU v1.0 · Nhân Rust Thuần" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
