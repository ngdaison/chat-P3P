<Window x:Class="P2PChatApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:P2PChatApp"
        mc:Ignorable="d"
        Title="P2P Chat - Sovereign Windows Client"
        Height="720" Width="1050"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom App Header -->
            <RowDefinition Height="46" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="P2P Chat" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Background="#1AFFFFFF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Pure Rust Core · Zero Server · E2EE" FontSize="11" Foreground="#00BCF9" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="NodeStatusDot" Width="9" Height="9" Fill="#107C41" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="NodeStatusText" Text="Online (Port 7001)" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />

                    <Button x:Name="BtnCopyMyId" Content="📋 Copy My Peer ID"
                            Style="{StaticResource FluentSecondaryButton}" Padding="8,4" FontSize="11"
                            Click="BtnCopyMyId_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY (SIDEBAR + VIEWS) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Navigation Sidebar -->
                <ColumnDefinition Width="220" />
                <!-- Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- My Identity Footer -->
                    <Border DockPanel.Dock="Bottom" Background="#14FFFFFF" Margin="10" Padding="10" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="MY IDENTITY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="TxtShortPeerId" Text="Loading..." FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtPeerCount" Text="0 peer(s) connected" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Navigation Items -->
                    <StackPanel Margin="0,10,0,0">
                        <RadioButton x:Name="NavDirectChat" Content="💬  Direct Messages"
                                     Style="{StaticResource FluentNavButton}" IsChecked="True"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavGroupChat" Content="👥  Encrypted Groups"
                                     Style="{StaticResource FluentNavButton}"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavContacts" Content="📖  Contacts"
                                     Style="{StaticResource FluentNavButton}"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavFiles" Content="📁  File Transfers"
                                     Style="{StaticResource FluentNavButton}"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavNetwork" Content="🌐  Network &amp; Relay"
                                     Style="{StaticResource FluentNavButton}"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSettings" Content="⚙️  Settings"
                                     Style="{StaticResource FluentNavButton}"
                                     Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- VIEW 1: DIRECT MESSAGES -->
            <Grid x:Name="ViewDirectChat" Grid.Column="1" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Contacts list for chat -->
                <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="#181818">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="CONVERSATIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <ListBox x:Name="LstChatContacts" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="LstChatContacts_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="4,2" CornerRadius="6" Background="{StaticResource CardBackgroundBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding Fingerprint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Chat conversation view -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="50" />
                        <!-- Message List -->
                        <RowDefinition Height="*" />
                        <!-- Input Bar -->
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>

                    <!-- Chat Header -->
                    <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                        <Grid VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtChatContactName" Text="Select a contact to begin"
                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtChatContactFingerprint" Text="" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <Button x:Name="BtnSendFileQuick" Content="📎 Send File"
                                    Style="{StaticResource FluentSecondaryButton}" HorizontalAlignment="Right"
                                    Click="BtnSendFileQuick_Click" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Message History -->
                    <ScrollViewer x:Name="ScrollMessages" Grid.Row="1" Padding="16,10">
                        <ItemsControl x:Name="ItemsMessages">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <!-- Outgoing bubble -->
                                        <Border HorizontalAlignment="Right" MaxWidth="520"
                                                Background="{StaticResource AccentBrush}" CornerRadius="10,10,2,10"
                                                Padding="12,8" Margin="40,0,0,0"
                                                Visibility="{Binding IsOutgoing, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="White" FontSize="13" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#D0E6FF" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#D0E6FF" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Incoming bubble -->
                                        <Border HorizontalAlignment="Left" MaxWidth="520"
                                                Background="{StaticResource CardBackgroundBrush}" CornerRadius="10,10,10,2"
                                                Padding="12,8" Margin="0,0,40,0"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                Visibility="{Binding IsOutgoing, Converter={StaticResource InverseBoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold" Foreground="#00BCF9" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                                <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Message Input Bar -->
                    <Border Grid.Row="2" Background="{StaticResource SidebarBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtMessageInput" Grid.Column="0"
                                     Style="{StaticResource FluentTextBox}"
                                     KeyDown="TxtMessageInput_KeyDown"
                                     Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Button x:Name="BtnSendMessage" Grid.Column="1" Content="Send  ➤"
                                    Style="{StaticResource FluentPrimaryButton}"
                                    Click="BtnSendMessage_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- VIEW 2: GROUP CHAT -->
            <Grid x:Name="ViewGroupChat" Grid.Column="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="#181818">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="ENCRYPTED GROUPS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <Button Content="+ Create" Style="{StaticResource FluentSecondaryButton}"
                                        Padding="6,3" FontSize="11" HorizontalAlignment="Right" Click="BtnCreateGroup_Click" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="LstGroups" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="LstGroups_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="4,2" CornerRadius="6" Background="{StaticResource CardBackgroundBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding Epoch, StringFormat='Epoch {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                        <Grid VerticalAlignment="Center">
                            <TextBlock x:Name="TxtActiveGroupName" Text="Select or create a group"
                                       FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button x:Name="BtnAddGroupMember" Content="+ Add Member"
                                    Style="{StaticResource FluentSecondaryButton}" HorizontalAlignment="Right"
                                    Click="BtnAddGroupMember_Click" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="ScrollGroupMessages" Grid.Row="1" Padding="16,10">
                        <StackPanel x:Name="PanelGroupMessages" />
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{StaticResource SidebarBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGroupMessageInput" Grid.Column="0"
                                     Style="{StaticResource FluentTextBox}"
                                     KeyDown="TxtGroupMessageInput_KeyDown"
                                     Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Button x:Name="BtnSendGroupMessage" Grid.Column="1" Content="Send to Group"
                                    Style="{StaticResource FluentPrimaryButton}"
                                    Click="BtnSendGroupMessage_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- VIEW 3: CONTACTS -->
            <Grid x:Name="ViewContacts" Grid.Column="1" Visibility="Collapsed" Margin="24">
                <DockPanel>
                    <!-- Add Contact Card -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Add New Contact" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewContactName" Grid.Column="0" Style="{StaticResource FluentTextBox}"
                                         Margin="0,0,10,0" />
                                <TextBox x:Name="TxtNewContactPubKey" Grid.Column="1" Style="{StaticResource FluentTextBox}"
                                         Margin="0,0,10,0" />
                                <Button x:Name="BtnAddContact" Grid.Column="2" Content="+ Add Contact"
                                        Style="{StaticResource FluentPrimaryButton}" Click="BtnAddContact_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Contact List -->
                    <ListBox x:Name="LstAllContacts" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                                        Padding="16,12" Margin="0,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Fingerprint, StringFormat='Security Fingerprint: {0}'}" FontSize="12"
                                                       Foreground="#00BCF9" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding PublicKey, StringFormat='Public Key: {0}'}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Chat"
                                                Style="{StaticResource FluentSecondaryButton}"
                                                Tag="{Binding}" Click="BtnChatWithContact_Click" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <!-- VIEW 4: FILE TRANSFERS -->
            <Grid x:Name="ViewFiles" Grid.Column="1" Visibility="Collapsed" Margin="24">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Send Encrypted File (Chunked 256 KiB)" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbFileContact" Grid.Column="0" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtFilePath" Grid.Column="1" Style="{StaticResource FluentTextBox}" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="Browse..." Style="{StaticResource FluentSecondaryButton}"
                                            Click="BtnBrowseFile_Click" Margin="0,0,8,0" />
                                    <Button Content="Send File" Style="{StaticResource FluentPrimaryButton}"
                                            Click="BtnSendFileAction_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="LstFileTransfers" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                                        Padding="14" Margin="0,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <!-- VIEW 5: NETWORK & RELAY DASHBOARD -->
            <ScrollViewer x:Name="ViewNetwork" Grid.Column="1" Visibility="Collapsed" Padding="24">
                <StackPanel>
                    <!-- Connect to Peer Card -->
                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                            Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Connect to Remote P2P Node" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtConnectPeerAddr" Grid.Column="0" Style="{StaticResource FluentTextBox}"
                                         Text="127.0.0.1:7002" Margin="0,0,10,0" />
                                <Button Grid.Column="1" Content="Connect Node" Style="{StaticResource FluentPrimaryButton}"
                                        Click="BtnConnectPeer_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Network Status Metrics -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1 -->
                        <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                                Padding="16" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="CONNECTED PEERS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtMetricConnected" Text="0" FontSize="26" FontWeight="Bold"
                                           Foreground="#00BCF9" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2 -->
                        <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                                Padding="16" Margin="4,0,4,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="KNOWN ADDRESSES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtMetricKnown" Text="0" FontSize="26" FontWeight="Bold"
                                           Foreground="#107C41" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3 -->
                        <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                                Padding="16" Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="RELAY STORAGE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtMetricRelay" Text="0 msgs (0 KB)" FontSize="18" FontWeight="Bold"
                                           Foreground="#FFB900" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Identity Hex Box -->
                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                            Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Full Public Key (X25519)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox x:Name="TxtFullPubKey" Style="{StaticResource FluentTextBox}" IsReadOnly="True"
                                     Margin="0,6,0,10" />

                            <TextBlock Text="Full Peer ID (SHA-256)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox x:Name="TxtFullPeerId" Style="{StaticResource FluentTextBox}" IsReadOnly="True"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- VIEW 6: SETTINGS -->
            <ScrollViewer x:Name="ViewSettings" Grid.Column="1" Visibility="Collapsed" Padding="24">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="Settings &amp; Architecture" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                            Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Core Technology" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="• Pure Rust Core: Zero third-party dependencies" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="• Native Windows GUI: Win32 DWM Mica + WPF Desktop + System Tray" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="• Cryptography: X25519 DH, Ed25519 Signatures, ChaCha20-Poly1305 AEAD" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="• Protocol: Sovereign P2P, Gossip Discovery, Store-and-Forward Relay" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Button Content="Open Downloads Folder in Windows Explorer"
                            Style="{StaticResource FluentSecondaryButton}" HorizontalAlignment="Left"
                            Click="BtnOpenDownloads_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatusBar" Text="Ready. P2P Chat Sovereign Node active." FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Windows 11 Native Client (WIU)" FontSize="11" Foreground="#666666"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
